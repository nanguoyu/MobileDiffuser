Run single-frame convolutions of the Wan VAE as 2D convolutions.

Image VAEs built on the Wan VAE (Qwen-Image 2.1 among them) keep Conv3d weights one frame deep, and
an image is one frame, so every such convolution is a 2D convolution. Metal has no im2col_3d, so
sd.cpp falls back to GGML_OP_CONV_3D, whose Metal kernel is a scalar loop per output element: a
512 x 512 Qwen-Image 2.1 decode takes 73 s on an M1 Pro. Routed through ggml_conv_2d it uses
im2col + mul_mat and takes 10 s. Activations go through im2col in f16, as sd.cpp's im2col_3d path
already does on CUDA and Vulkan.

Applied by scripts/build-sdcpp-xcframework.sh on top of the pinned stable-diffusion.cpp commit.

diff --git a/src/model/vae/wan_vae.hpp b/src/model/vae/wan_vae.hpp
index 035deae..15993a3 100644
--- a/src/model/vae/wan_vae.hpp
+++ b/src/model/vae/wan_vae.hpp
@@ -82,6 +82,21 @@ namespace WAN {
             }
 
             x = ggml_ext_pad_ext(ctx->ggml_ctx, ctx->backend, x, lp0, rp0, lp1, rp1, lp2, rp2, 0, 0, ctx->circular_x_enabled, ctx->circular_y_enabled);
+            if (w->ne[2] == 1 && x->ne[2] == 1 && x->ne[3] == in_channels) {
+                // One frame through a kernel one frame deep (image VAEs) is a 2D convolution. Run it
+                // as one so it takes the backend's fast 2D path: Metal has no im2col_3d, and its
+                // direct conv_3d kernel is a scalar loop many times slower than im2col + mul_mat.
+                if (!ggml_is_contiguous(x)) {
+                    x = ggml_cont(ctx->ggml_ctx, x);
+                }
+                ggml_tensor* x2 = ggml_reshape_4d(ctx->ggml_ctx, x, x->ne[0], x->ne[1], in_channels, 1);
+                ggml_tensor* w2 = ggml_reshape_4d(ctx->ggml_ctx, w, w->ne[0], w->ne[1], in_channels, out_channels);
+                x2              = ggml_ext_conv_2d(ctx->ggml_ctx, x2, w2, b,
+                                                   std::get<2>(stride), std::get<1>(stride), 0, 0,
+                                                   std::get<2>(dilation), std::get<1>(dilation),
+                                                   ctx->conv2d_direct_enabled);
+                return ggml_reshape_4d(ctx->ggml_ctx, x2, x2->ne[0], x2->ne[1], 1, out_channels);
+            }
             return ggml_ext_conv_3d(ctx->ggml_ctx, ctx->backend, x, w, b, in_channels,
                                     std::get<2>(stride), std::get<1>(stride), std::get<0>(stride),
                                     0, 0, 0,
